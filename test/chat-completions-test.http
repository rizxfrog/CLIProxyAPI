@Token = sk-test
@BASE_URL = http://localhost:8317
@MODEL_ID = qmodel_38max
@QWEN_WEB_CHAT = qwen-web-chat
@QWEN_WEB_IMAGE = qwen-web-image

### chat-completions

POST {{BASE_URL}}/v1/chat/completions
Authorization: Bearer {{Token}}
Content-Type: application/json

{
    "model": "{{ MODEL_ID }}",
    "messages": [{"role": "user", "content": "hi"}],
    "stream": false
  }

### chat-completions sse

POST {{BASE_URL}}/v1/chat/completions
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "model": "{{ MODEL_ID }}",
  "messages": [{"role": "user", "content": "hi"}],
  "stream": true
}

### chat-completions thinking (reasoning_effort=high)

POST {{BASE_URL}}/v1/chat/completions
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "model": "{{ MODEL_ID }}",
  "messages": [{"role": "user", "content": "9.11 和 9.9 哪个大？请一步步推理。"}],
  "reasoning_effort": "high",
  "stream": false
}

### chat-completions thinking (reasoning_effort=high, streaming)

POST {{BASE_URL}}/v1/chat/completions
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "model": "{{ MODEL_ID }}",
  "messages": [{"role": "user", "content": "9.11 和 9.9 哪个大？请一步步推理。"}],
  "reasoning_effort": "high",
  "stream": true
}

