POST {{BASE_URL}}/v1/chat/completions
Authorization: Bearer {{Token}}
Content-Type: application/json

{
  "model": "{{ MODEL_ID }}",
  "messages": [{"role": "user", "content": "hi"}],
  "reasoning_effort": "none",
  "stream": false
}

